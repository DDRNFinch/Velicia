class_name VeliciaMaterials
extends RefCounted
## Central library of textured materials. Everything that draws the world
## (terrain, structures, foliage, water, sky, characters) gets its materials
## here, so swapping in final textures is a one-place change.
## Textures: res://textures (generated by tools/generate_textures.py).

const TEX := "res://textures/"

static var _cache: Dictionary = {}


static func tex(name: String) -> Texture2D:
	var path := TEX + name + ".png"
	if not _cache.has(path):
		_cache[path] = load(path) if ResourceLoader.exists(path) else null
	return _cache[path]


static func _shader(name: String) -> Shader:
	var path := "res://shaders/%s.gdshader" % name
	if not _cache.has(path):
		_cache[path] = load(path)
	return _cache[path]


static func terrain() -> ShaderMaterial:
	if _cache.has("m_terrain"):
		return _cache.m_terrain
	var m := ShaderMaterial.new()
	m.shader = _shader("terrain")
	for t in ["grass", "dirt", "rock"]:
		m.set_shader_parameter(t + "_albedo", tex(t + "_albedo"))
		m.set_shader_parameter(t + "_normal", tex(t + "_normal"))
	m.set_shader_parameter("sand_albedo", tex("sand_albedo"))
	m.set_shader_parameter("snow_albedo", tex("snow_albedo"))
	m.set_shader_parameter("macro_noise", tex("noise"))
	_cache.m_terrain = m
	return m


static func foliage(kind: String) -> ShaderMaterial:
	var key := "m_foliage_" + kind
	if _cache.has(key):
		return _cache[key]
	var m := ShaderMaterial.new()
	m.shader = _shader("foliage")
	m.set_shader_parameter("albedo_tex", tex(kind + "_albedo"))
	if kind == "needles":
		m.set_shader_parameter("wind_strength", 0.07)
		m.set_shader_parameter("alpha_cut", 0.35)
	_cache[key] = m
	return m


static func grass(fade_end: float) -> ShaderMaterial:
	var key := "m_grass_%d" % int(fade_end)
	if _cache.has(key):
		return _cache[key]
	var m := ShaderMaterial.new()
	m.shader = _shader("grass")
	m.set_shader_parameter("grass_albedo", tex("grass_albedo"))
	m.set_shader_parameter("noise_tex", tex("noise"))
	m.set_shader_parameter("fade_end", fade_end)
	m.set_shader_parameter("fade_start", fade_end * 0.7)
	_cache[key] = m
	return m


static func water() -> ShaderMaterial:
	if _cache.has("m_water"):
		return _cache.m_water
	var m := ShaderMaterial.new()
	m.shader = _shader("water")
	m.set_shader_parameter("normal_tex", tex("water_normal"))
	_cache.m_water = m
	return m


static func sky() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = _shader("sky")
	m.set_shader_parameter("cloud_noise", tex("noise"))
	return m


## Tiling PBR material projected in world space (good for modular structures).
static func surface(name: String, tint: Color = Color.WHITE, scale: float = 0.5, roughness: float = 0.9, world: bool = true) -> StandardMaterial3D:
	var key := "s_%s_%s_%.2f_%.2f_%s" % [name, tint.to_html(), scale, roughness, world]
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_color = tint
	m.albedo_texture = tex(name + "_albedo")
	var n := tex(name + "_normal")
	if n:
		m.normal_enabled = true
		m.normal_texture = n
		m.normal_scale = 1.0
	m.roughness = roughness
	m.uv1_triplanar = true
	m.uv1_world_triplanar = world
	m.uv1_scale = Vector3.ONE * scale
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_cache[key] = m
	return m
