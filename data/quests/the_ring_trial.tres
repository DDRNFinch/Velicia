journal_text = "Return to Master Oddrin with your companion."
objectives = Array[ExtResource("3_2ncld")]([SubResource("Resource_61svq")])

[resource]
script = ExtResource("1_pbpfh")
id = &"the_ring_trial"
title = "The Ring Trial"
summary = "Master Oddrin will teach you the rings once you have bound a creature."
is_main = false
is_draft = true
