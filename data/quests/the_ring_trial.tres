[sub_resource type="Resource" id="Resource_g5tmf"]
script = ExtResource("2_cxhs1")
id = &"capture"
journal_text = "Weaken a wild creature and bind it to your Apprentice Ring. Mossglade, west of the outpost, is full of them."
objectives = Array[ExtResource("3_2ncld")]([SubResource("Resource_nvymf")])

[sub_resource type="Resource" id="Resource_tkyht"]
script = ExtResource("3_2ncld")
type = 6
target = &"any"
count = 1
